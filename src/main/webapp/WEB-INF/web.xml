<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">
    <display-name>CampusHub</display-name>

    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>cn.campushub.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>cn.campushub.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/profile</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/favorites</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/post/publish</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/api/private/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ContentServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.ContentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ContentServlet</servlet-name>
        <url-pattern>/content</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HomeDataServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.HomeDataServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeDataServlet</servlet-name>
        <url-pattern>/api/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CheckinServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.CheckinServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckinServlet</servlet-name>
        <url-pattern>/checkin/do</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.PostServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostServlet</servlet-name>
        <url-pattern>/post/publish</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostDetailServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.PostDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostDetailServlet</servlet-name>
        <url-pattern>/post/detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostCommentServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.PostCommentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostCommentServlet</servlet-name>
        <url-pattern>/post/comment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostLikeServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.PostLikeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostLikeServlet</servlet-name>
        <url-pattern>/post/like</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostFavoriteServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.PostFavoriteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostFavoriteServlet</servlet-name>
        <url-pattern>/post/favorite</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostUpdateServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.PostUpdateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostUpdateServlet</servlet-name>
        <url-pattern>/post/update</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostDeleteServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.PostDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostDeleteServlet</servlet-name>
        <url-pattern>/post/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoodsCreateServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.GoodsCreateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoodsCreateServlet</servlet-name>
        <url-pattern>/goods/create</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoodsDetailServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.GoodsDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoodsDetailServlet</servlet-name>
        <url-pattern>/goods/detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoodsFavoriteServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.GoodsFavoriteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoodsFavoriteServlet</servlet-name>
        <url-pattern>/goods/favorite</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoodsUpdateServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.GoodsUpdateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoodsUpdateServlet</servlet-name>
        <url-pattern>/goods/update</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoodsStatusServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.GoodsStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoodsStatusServlet</servlet-name>
        <url-pattern>/goods/status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoodsDeleteServlet</servlet-name>
        <servlet-class>cn.campushub.servlet.GoodsDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoodsDeleteServlet</servlet-name>
        <url-pattern>/goods/delete</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
</web-app>
